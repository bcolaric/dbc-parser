<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DbcParser.App.MainWindow"
        Title="DBC Parser"
        Width="800"
        Height="600">

    <DockPanel Margin="10">

        <Button DockPanel.Dock="Top"
                Content="Load DBC file"
                Click="OnLoadDbcClicked"
                Height="30"/>

        <ScrollViewer Margin="0,10,0,0">
            <TextBox Name="DbcContentTextBox"
                     AcceptsReturn="True"
                     IsReadOnly="True"/>
        </ScrollViewer>

    </DockPanel>
</Window>